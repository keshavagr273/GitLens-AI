# ==============================================================================
# GitLens AI — Production & Deployment Environment Variables
# ==============================================================================

# --- Server & Networking ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGIN=*

# --- Web Frontend API Endpoint ---
# In production, set this to your backend API URL (e.g. https://api.yourdomain.com or https://gitlens-api.up.railway.app)
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Database & Cache ---
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/gitlens
REDIS_URL=redis://localhost:6379

# --- AI Model Providers (Groq, OpenAI, Anthropic, Gemini, or Mock) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# --- Optional GitHub Personal Access Token & Enterprise API Base ---
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Pipeline Limits ---
MAX_REPOSITORY_SIZE_MB=100
MAX_FILE_SIZE_KB=500
MAX_CONCURRENT_ANALYSES=4

# --- Docker Build Configuration (Optional) ---
# Set to 'true' or '1' when building containerized standalone Next.js image
DOCKER_BUILD=
