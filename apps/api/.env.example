# API Server Environment
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGIN=*

# PostgreSQL & Redis (Optional - falls back to high-performance in-memory engine if omitted)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/gitlens
REDIS_URL=redis://localhost:6379

# AI Models
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# GitHub API token (Optional - increases rate limits)
GITHUB_TOKEN=
